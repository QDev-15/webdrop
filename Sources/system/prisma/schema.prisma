generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["webdrop"]
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  password     String
  role         UserRole      @default(user)
  createdAt    DateTime      @default(now()) @map("created_at")
  activityLogs ActivityLog[]
  cvProfile    CvProfile?
  media        Media[]
  pages        Page[]
  posts        Post[]
  helpArticles HelpArticle[] @relation("helpArticles")
  projectFiles ProjectFile[]
  projectNotes ProjectNote[]

  @@map("users")
  @@schema("webdrop")
}

model Post {
  id              Int        @id @default(autoincrement())
  title           String
  slug            String     @unique
  content         String?
  excerpt         String?
  thumbnail       String?
  categoryId      Int?       @map("category_id")
  status          PostStatus @default(draft)
  featured        Boolean    @default(false)
  metaTitle       String?    @map("meta_title")
  metaDescription String?    @map("meta_description")
  createdBy       Int?       @map("created_by")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  category        Category?  @relation(fields: [categoryId], references: [id])
  author          User?      @relation(fields: [createdBy], references: [id])

  @@map("posts")
  @@schema("webdrop")
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String?
  thumbnail   String?
  parentId    Int?       @map("parent_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  parent      Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryChildren")
  posts       Post[]

  @@map("categories")
  @@schema("webdrop")
}

model Page {
  id              Int        @id @default(autoincrement())
  title           String
  slug            String     @unique
  content         String?
  template        String?
  metaTitle       String?    @map("meta_title")
  metaDescription String?    @map("meta_description")
  status          PostStatus @default(draft)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  createdBy       Int?       @map("created_by")
  author          User?      @relation(fields: [createdBy], references: [id])

  @@map("pages")
  @@schema("webdrop")
}

model Media {
  id         Int      @id @default(autoincrement())
  filename   String
  filepath   String
  filesize   Int
  filetype   String
  altText    String?  @map("alt_text")
  uploadedBy Int?     @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")
  uploader   User?    @relation(fields: [uploadedBy], references: [id])

  @@map("media")
  @@schema("webdrop")
}

model Banner {
  id        Int          @id @default(autoincrement())
  title     String
  image     String
  link      String?
  target    BannerTarget @default(self)
  position  String
  sortOrder Int          @default(0) @map("sort_order")
  status    PostStatus   @default(draft)
  createdAt DateTime     @default(now()) @map("created_at")

  @@map("banners")
  @@schema("webdrop")
}

model Contact {
  id        Int           @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  subject   String?
  message   String
  status    ContactStatus @default(new)
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("contacts")
  @@schema("webdrop")
}

model Setting {
  key   String  @id
  value String?
  group String

  @@map("settings")
  @@schema("webdrop")
}

model PageView {
  id        Int      @id @default(autoincrement())
  path      String
  referrer  String?
  ipHash    String?  @map("ip_hash")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([path])
  @@map("page_views")
  @@schema("webdrop")
}

model Industry {
  id                Int               @id @default(autoincrement())
  name              String
  slug              String            @unique
  description       String?
  status            PostStatus        @default(published)
  sortOrder         Int               @default(0) @map("sort_order")
  packageIndustries PackageIndustry[]
  templates         Template[]

  @@map("industries")
  @@schema("webdrop")
}

model ServicePackage {
  id                Int               @id @default(autoincrement())
  name              String
  code              String            @unique
  description       String?
  priceFrom         Decimal?          @map("price_from")
  priceTo           Decimal?          @map("price_to")
  status            PostStatus        @default(published)
  sortOrder         Int               @default(0) @map("sort_order")
  orders            Order[]
  packageIndustries PackageIndustry[]

  @@map("service_packages")
  @@schema("webdrop")
}

model PackageIndustry {
  packageId  Int            @map("package_id")
  industryId Int            @map("industry_id")
  industry   Industry       @relation(fields: [industryId], references: [id])
  package    ServicePackage @relation(fields: [packageId], references: [id])

  @@id([packageId, industryId])
  @@map("package_industries")
  @@schema("webdrop")
}

model Template {
  id           Int              @id @default(autoincrement())
  name         String
  slug         String           @unique
  description  String?
  thumbnail    String?
  demoUrl      String?          @map("demo_url")
  downloadUrl  String?          @map("download_url")
  price        Decimal
  category     TemplateCategory
  industryId   Int?             @map("industry_id")
  salesCount   Int              @default(0) @map("sales_count")
  status       PostStatus       @default(draft)
  createdAt    DateTime         @default(now()) @map("created_at")
  hasWebsite   Boolean          @default(false) @map("has_website")
  customPrice  Decimal?         @map("custom_price")
  websitePrice Decimal?         @map("website_price")
  deployUrl    String?          @map("deploy_url")
  industry     Industry?        @relation(fields: [industryId], references: [id])

  @@map("templates")
  @@schema("webdrop")
}

model Customer {
  id        Int               @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  company   String?
  address   String?
  note      String?
  status    CustomerStatus    @default(active)
  createdAt DateTime          @default(now()) @map("created_at")
  contacts  CustomerContact[]
  orders    Order[]
  projects  Project[]

  @@map("customers")
  @@schema("webdrop")
}

model CustomerContact {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id")
  type       String
  value      String
  note       String?
  customer   Customer @relation(fields: [customerId], references: [id])

  @@map("customer_contacts")
  @@schema("webdrop")
}

model Order {
  id             Int             @id @default(autoincrement())
  code           String          @unique
  customerId     Int             @map("customer_id")
  packageId      Int?            @map("package_id")
  type           OrderType
  title          String
  price          Decimal
  discount       Decimal         @default(0)
  total          Decimal
  status         OrderStatus     @default(new)
  note           String?
  startedAt      DateTime?       @map("started_at")
  deadlineAt     DateTime?       @map("deadline_at")
  completedAt    DateTime?       @map("completed_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  downloadToken  String?         @unique @map("download_token")
  paidAt         DateTime?       @map("paid_at")
  tokenExpiresAt DateTime?       @map("token_expires_at")
  tokenUsedCount Int             @default(0) @map("token_used_count")
  discountCode   String?         @map("discount_code")
  contracts      Contract[]
  items          OrderItem[]
  customer       Customer        @relation(fields: [customerId], references: [id])
  package        ServicePackage? @relation(fields: [packageId], references: [id])
  payments       Payment[]
  project        Project?
  revenues       Revenue[]

  @@map("orders")
  @@schema("webdrop")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  itemType  String  @map("item_type")
  itemName  String  @map("item_name")
  qty       Int     @default(1)
  unitPrice Decimal @map("unit_price")
  subtotal  Decimal
  note      String?
  order     Order   @relation(fields: [orderId], references: [id])

  @@map("order_items")
  @@schema("webdrop")
}

model Contract {
  id       Int       @id @default(autoincrement())
  orderId  Int       @map("order_id")
  fileUrl  String?   @map("file_url")
  signedAt DateTime? @map("signed_at")
  note     String?
  order    Order     @relation(fields: [orderId], references: [id])

  @@map("contracts")
  @@schema("webdrop")
}

model Payment {
  id         Int           @id @default(autoincrement())
  orderId    Int           @map("order_id")
  amount     Decimal
  method     PaymentMethod
  status     PaymentStatus @default(pending)
  paidAt     DateTime?     @map("paid_at")
  note       String?
  receiptUrl String?       @map("receipt_url")
  order      Order         @relation(fields: [orderId], references: [id])
  revenues   Revenue[]

  @@map("payments")
  @@schema("webdrop")
}

model Project {
  id          Int                @id @default(autoincrement())
  orderId     Int                @unique @map("order_id")
  customerId  Int                @map("customer_id")
  name        String
  type        ProjectType
  status      ProjectStatus      @default(planning)
  hostingInfo String?            @map("hosting_info")
  domain      String?
  adminUrl    String?            @map("admin_url")
  note        String?
  createdAt   DateTime           @default(now()) @map("created_at")
  files       ProjectFile[]
  milestones  ProjectMilestone[]
  notes       ProjectNote[]
  customer    Customer           @relation(fields: [customerId], references: [id])
  order       Order              @relation(fields: [orderId], references: [id])

  @@map("projects")
  @@schema("webdrop")
}

model ProjectMilestone {
  id          Int             @id @default(autoincrement())
  projectId   Int             @map("project_id")
  title       String
  description String?
  status      MilestoneStatus @default(pending)
  dueAt       DateTime?       @map("due_at")
  completedAt DateTime?       @map("completed_at")
  project     Project         @relation(fields: [projectId], references: [id])

  @@map("project_milestones")
  @@schema("webdrop")
}

model ProjectNote {
  id            Int      @id @default(autoincrement())
  projectId     Int      @map("project_id")
  content       String
  createdBy     Int?     @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  createdByUser User?    @relation(fields: [createdBy], references: [id])
  project       Project  @relation(fields: [projectId], references: [id])

  @@map("project_notes")
  @@schema("webdrop")
}

model ProjectFile {
  id             Int      @id @default(autoincrement())
  projectId      Int      @map("project_id")
  filename       String
  filepath       String
  type           String
  uploadedBy     Int?     @map("uploaded_by")
  createdAt      DateTime @default(now()) @map("created_at")
  project        Project  @relation(fields: [projectId], references: [id])
  uploadedByUser User?    @relation(fields: [uploadedBy], references: [id])

  @@map("project_files")
  @@schema("webdrop")
}

model Revenue {
  id        Int      @id @default(autoincrement())
  orderId   Int?     @map("order_id")
  paymentId Int?     @map("payment_id")
  amount    Decimal
  month     Int
  year      Int
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  order     Order?   @relation(fields: [orderId], references: [id])
  payment   Payment? @relation(fields: [paymentId], references: [id])

  @@map("revenues")
  @@schema("webdrop")
}

model Expense {
  id        Int       @id @default(autoincrement())
  type      String
  title     String
  amount    Decimal
  paidAt    DateTime? @map("paid_at")
  note      String?
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("expenses")
  @@schema("webdrop")
}

model HeroSlide {
  id        Int        @id @default(autoincrement())
  type      SlideType
  bg        String
  badge     String
  title     Json
  data      Json
  buttons   Json
  sortOrder Int        @default(0) @map("sort_order")
  status    PostStatus @default(published)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("hero_slides")
  @@schema("webdrop")
}

model PricingGroup {
  id          Int              @id @default(autoincrement())
  slug        String           @unique
  eyebrow     String?
  title       String
  titleEm     String?          @map("title_em")
  subtitle    String?
  footnote    String?
  bg          PricingBg        @default(light)
  type        PricingGroupType @default(cards)
  description String?
  tags        String[]
  ctaLabel    String?          @map("cta_label")
  ctaHref     String?          @map("cta_href")
  sortOrder   Int              @default(0) @map("sort_order")
  status      PostStatus       @default(published)
  plans       PricingPlan[]

  @@map("pricing_groups")
  @@schema("webdrop")
}

model PricingPlan {
  id        Int          @id @default(autoincrement())
  groupId   Int          @map("group_id")
  name      String
  price     String
  features  String[]
  hot       Boolean      @default(false)
  ctaLabel  String?      @map("cta_label")
  ctaHref   String?      @map("cta_href")
  sortOrder Int          @default(0) @map("sort_order")
  group     PricingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("pricing_plans")
  @@schema("webdrop")
}

model PricingFaq {
  id        Int        @id @default(autoincrement())
  question  String
  answer    String
  sortOrder Int        @default(0) @map("sort_order")
  status    PostStatus @default(published)

  @@map("pricing_faqs")
  @@schema("webdrop")
}

model HowItWorksPackage {
  id        Int              @id @default(autoincrement())
  name      String
  slug      String           @unique
  tagline   String?
  icon      String?          @default("📦")
  price     String?
  hot       Boolean          @default(false)
  ctaLabel  String?          @map("cta_label")
  ctaHref   String?          @map("cta_href")
  suitable  String[]
  sortOrder Int              @default(0) @map("sort_order")
  status    PostStatus       @default(published)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  steps     HowItWorksStep[]

  @@map("how_it_works_packages")
  @@schema("webdrop")
}

model HowItWorksStep {
  id        Int               @id @default(autoincrement())
  packageId Int               @map("package_id")
  title     String
  desc      String?
  sortOrder Int               @default(0) @map("sort_order")
  package   HowItWorksPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@map("how_it_works_steps")
  @@schema("webdrop")
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  adminId     Int?     @map("admin_id")
  action      String
  targetType  String?  @map("target_type")
  targetId    Int?     @map("target_id")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  admin       User?    @relation(fields: [adminId], references: [id])

  @@map("activity_logs")
  @@schema("webdrop")
}

model DiscountCode {
  id        Int          @id @default(autoincrement())
  code      String       @unique
  type      DiscountType
  value     Decimal
  maxUses   Int?         @map("max_uses")
  usedCount Int          @default(0) @map("used_count")
  expiresAt DateTime?    @map("expires_at")
  isActive  Boolean      @default(true) @map("is_active")
  note      String?
  createdAt DateTime     @default(now()) @map("created_at")

  @@map("discount_codes")
  @@schema("webdrop")
}

model CvProfile {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique @map("user_id")
  templateType String   @default("classic") @map("template_type")
  slug         String   @unique
  isPublic     Boolean  @default(true) @map("is_public")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  data         CvData?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cv_profiles")
  @@schema("webdrop")
}

model CvData {
  id             Int       @id @default(autoincrement())
  cvId           Int       @unique @map("cv_id")
  fullName       String?   @map("full_name")
  jobTitle       String?   @map("job_title")
  avatarUrl      String?   @map("avatar_url")
  summary        String?
  email          String?
  phone          String?
  location       String?
  website        String?
  linkedin       String?
  github         String?
  twitter        String?
  experience     Json?
  education      Json?
  skills         Json?
  projects       Json?
  certifications Json?
  languages      Json?
  updatedAt      DateTime  @updatedAt @map("updated_at")
  cv             CvProfile @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@map("cv_data")
  @@schema("webdrop")
}

model HelpCategory {
  id          Int           @id @default(autoincrement())
  name        String
  slug        String        @unique
  description String?
  icon        String?
  sortOrder   Int           @default(0) @map("sort_order")
  status      PostStatus    @default(published)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  articles    HelpArticle[]

  @@map("help_categories")
  @@schema("webdrop")
}

model HelpArticle {
  id              Int          @id @default(autoincrement())
  title           String
  slug            String       @unique
  content         String       @db.Text
  excerpt         String?
  metaTitle       String?      @map("meta_title")
  metaDescription String?      @map("meta_description")
  categoryId      Int          @map("category_id")
  status          PostStatus   @default(published)
  sortOrder       Int          @default(0) @map("sort_order")
  createdBy       Int?         @map("created_by")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  category        HelpCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  author          User?        @relation("helpArticles", fields: [createdBy], references: [id])
  tags            HelpTag[]

  @@index([categoryId])
  @@index([slug])
  @@index([status])
  @@map("help_articles")
  @@schema("webdrop")
}

model HelpTag {
  id       Int           @id @default(autoincrement())
  name     String
  slug     String        @unique
  articles HelpArticle[]

  @@map("help_tags")
  @@schema("webdrop")
}

enum UserRole {
  superadmin
  user

  @@schema("webdrop")
}

enum PostStatus {
  draft
  published

  @@schema("webdrop")
}

enum BannerTarget {
  blank
  self

  @@schema("webdrop")
}

enum ContactStatus {
  new
  read
  replied

  @@schema("webdrop")
}

enum TemplateCategory {
  web
  admin

  @@schema("webdrop")
}

enum CustomerStatus {
  active
  inactive

  @@schema("webdrop")
}

enum OrderType {
  template
  website
  cv

  @@schema("webdrop")
}

enum OrderStatus {
  new
  confirmed
  in_progress
  delivered
  completed
  cancelled

  @@schema("webdrop")
}

enum PaymentMethod {
  cash
  bank
  momo
  vnpay

  @@schema("webdrop")
}

enum PaymentStatus {
  pending
  paid
  refunded

  @@schema("webdrop")
}

enum ProjectType {
  goi_b
  goi_c

  @@schema("webdrop")
}

enum ProjectStatus {
  planning
  designing
  developing
  reviewing
  delivered
  done

  @@schema("webdrop")
}

enum MilestoneStatus {
  pending
  done

  @@schema("webdrop")
}

enum SlideType {
  intro
  features
  grid
  pricing
  testimonial

  @@schema("webdrop")
}

enum PricingGroupType {
  cards
  banner

  @@schema("webdrop")
}

enum PricingBg {
  light
  warm
  dark

  @@schema("webdrop")
}

enum DiscountType {
  percent
  fixed

  @@schema("webdrop")
}

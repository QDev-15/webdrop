<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <directoryBrowse enabled="false" />

        <rewrite>
            <rules>
                <!-- Bỏ qua file/thư mục tồn tại thực sự -->
                <rule name="SkipExisting" stopProcessing="true">
                    <match url=".*" />
                    <conditions logicalGrouping="MatchAny">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
                    </conditions>
                    <action type="None" />
                </rule>

                <!-- Admin SPA — /admin/* → /admin/index.html -->
                <rule name="AdminSPA" stopProcessing="true">
                    <match url="^admin(/.*)?$" />
                    <action type="Rewrite" url="/admin/index.html" />
                </rule>

                <!-- Bỏ qua /api/ — có web.config riêng trong thư mục api/ -->
                <rule name="SkipApi" stopProcessing="true">
                    <match url="^api/" />
                    <action type="None" />
                </rule>

                <!-- Website SPA — tất cả còn lại → /index.html -->
                <rule name="WebsiteSPA" stopProcessing="true">
                    <match url=".*" />
                    <action type="Rewrite" url="/index.html" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>

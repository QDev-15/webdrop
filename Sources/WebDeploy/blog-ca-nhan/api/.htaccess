Options -Indexes

# Block direct access to database files
<FilesMatch "\.db$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block access to database directory
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^database/ - [F,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]
</IfModule>
